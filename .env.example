APP_NAME=GraphSearch PDF Multimodal Retrieval
SECRET_KEY=change-me-before-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Local development defaults
DATABASE_URL=postgresql+psycopg://graphsearch:graphsearch@postgres:5432/graphsearch
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
USE_RQ=true
STORAGE_DIR=/data/storage

# Model provider:
# - openai_compatible: cloud API using /embeddings and /chat/completions
# - ollama: local Ollama
# - none: deterministic local fallback only
MODEL_PROVIDER=openai_compatible

# Cloud model API. Use a provider's OpenAI-compatible base URL, usually ending with /v1.
# Examples:
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# SiliconFlow: https://api.siliconflow.cn/v1
# LongCat: https://api.longcat.chat/openai/v1
CLOUD_API_BASE_URL=https://api.longcat.chat/openai/v1
CLOUD_API_KEY=replace-with-your-api-key
CLOUD_EMBEDDING_MODEL=
CLOUD_CHAT_MODEL=LongCat-Flash-Chat
CLOUD_TIMEOUT_SECONDS=90

# Optional: use a separate cloud embedding provider when the chat provider
# does not expose /embeddings. Example OpenAI-compatible values:
# EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=replace-with-dashscope-api-key
# EMBEDDING_API_MODEL=text-embedding-v4
EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace-with-dashscope-api-key
EMBEDDING_API_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Optional multimodal image/page embedding for text-to-image retrieval.
# Alibaba Cloud Model Studio DashScope multimodal embedding:
# https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
IMAGE_EMBEDDING_PROVIDER=dashscope
IMAGE_EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
IMAGE_EMBEDDING_API_KEY=replace-with-dashscope-api-key
IMAGE_EMBEDDING_API_MODEL=tongyi-embedding-vision-flash-2026-03-06
IMAGE_EMBEDDING_DIMENSIONS=768

# Optional table/image summary with Qwen-VL compatible API.
VISION_SUMMARY_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_SUMMARY_API_KEY=replace-with-dashscope-api-key
VISION_SUMMARY_MODEL=qwen-vl-plus
TABLE_SUMMARY_ENABLED=true
RERANKER_ENABLED=false
RERANKER_URL=http://reranker:8001
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_USE_FP16=false
RERANKER_TIMEOUT_SECONDS=8
RERANKER_CANDIDATE_MULTIPLIER=5
RERANKER_MAX_CANDIDATES=30
RERANKER_BATCH_SIZE=4
EMBEDDING_DIM=1536

LAYOUT_DETECTION_BACKEND=heuristic
TABLE_STRUCTURE_BACKEND=auto
FIGURE_REGION_VISION_ENABLED=true
FIGURE_REGION_OCR_ENABLED=true
PROCESS_IMAGE_RESERVE_RATIO=0.3

# Ollama fallback settings, only used when MODEL_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5:7b-instruct

# none | paddle | tesseract
OCR_BACKEND=none
CLOUD_OCR_ENABLED=false
CLOUD_OCR_MODEL=qwen-vl-plus
CLOUD_OCR_MAX_PAGES=5
OCR_LANG=chi_sim+eng

MAX_UPLOAD_MB=2048
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
